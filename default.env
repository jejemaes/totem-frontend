# Committed development defaults, loaded by docker-compose via `env_file`.
# Convention borrowed from totem-backend: `default.env` is committed, `.env` is
# gitignored.
#
# WARNING: every VITE_* variable is INLINED INTO THE BUNDLE AT BUILD TIME.
# They are neither runtime configuration nor secret. One image serves every
# tenant, so nothing tenant-specific (slug, branding, feature flags) can live
# here -- it would be frozen at build time for all domains. Such values must
# come from the backend at runtime.

# --- dev server (never reaches the bundle) ---------------------------------
VITE_PORT=5173

# Set to 1 only on Docker Desktop (macOS/Windows) or WSL2 with the repo under
# /mnt/c: inotify does not cross those filesystems, so HMR needs polling.
# It costs real CPU -- leave at 0 on Linux.
VITE_USE_POLLING=0

# --- application (inlined into the bundle) ---------------------------------
VITE_APP_TITLE=Totem Admin
