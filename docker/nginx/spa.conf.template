# Runtime nginx config for the Totem admin SPA.
#
# Rendered into /etc/nginx/conf.d/spa.conf at container start by nginx's own
# /docker-entrypoint.d/20-envsubst-on-templates.sh. Only ${APP_PORT} and
# ${APP_BASE_PATH} are substituted -- nginx's own $uri survives because envsubst
# replaces environment variables only, and there is no `uri` variable in the
# environment.
#
#   APP_BASE_PATH  the prefix this app is mounted under, with both slashes
#                  ("/" or "/tabou/"). Must match the Vite `base` the bundle was
#                  built with, which is why both come from the same build arg.
#   APP_PORT       the port totem-proxy's `domain` row points at.
#
# This container serves static files only: there is no backend integration at
# this stage. totem-proxy resolves the tenant from the Host header and sends
# everything outside APP_BASE_PATH to the tenant's backend.

server {
    listen ${APP_PORT};
    server_name _;
    charset utf-8;

    root /usr/share/nginx/html;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 325;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff2;

    # Health probe, deliberately outside APP_BASE_PATH so it stays reachable
    # regardless of the prefix.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite emits content-hashed filenames here (index-B7kd9F2x.js). The name
    # changes whenever the content changes, so these can be cached forever.
    # `add_header` only, no `expires`: the two directives each emit their own
    # Cache-Control, which would send the header twice.
    location ^~ ${APP_BASE_PATH}assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The entry point must NEVER be cached: it is the file that points at the
    # current hashed bundle. A stale index.html after a deploy references assets
    # that no longer exist -- a white page with 404s in the console.
    location = ${APP_BASE_PATH}index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # SPA history fallback. vue-router runs in createWebHistory mode, so
    # /diagnostic is a real URL: a hard refresh on it must return index.html
    # rather than a 404.
    location ${APP_BASE_PATH} {
        try_files $uri $uri/ ${APP_BASE_PATH}index.html;
    }
}
